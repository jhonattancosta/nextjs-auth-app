# URL onde o app roda (em produção, troque pelo domínio real)
NEXTAUTH_URL=http://localhost:3000

# Segredo usado para assinar/criptografar o JWT da sessão.
# Gere um com:  npx auth secret   ou   openssl rand -base64 32
NEXTAUTH_SECRET=troque-por-um-segredo-aleatorio

# Usuário de demonstração para o login com e-mail e senha
DEMO_USER_EMAIL=admin@exemplo.com
DEMO_USER_PASSWORD=123456

# (Opcional) Login com GitHub — crie um OAuth App em
# https://github.com/settings/developers  (callback: http://localhost:3000/api/auth/callback/github)
GITHUB_ID=
GITHUB_SECRET=
